{
	"name": "@jstnmcbrd/eslint-config",
	"version": "3.0.0",
	"description": "Justin's ESLint configuration",
	"keywords": [
		"eslint",
		"eslint-config",
		"eslintconfig"
	],
	"homepage": "https://github.com/JstnMcBrd/eslint-config",
	"bugs": "https://github.com/JstnMcBrd/eslint-config/issues",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/JstnMcBrd/eslint-config.git"
	},
	"license": "ISC",
	"author": "Justin McBride",
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"lint": "eslint --flag unstable_native_nodejs_ts_config"
	},
	"dependencies": {
		"@eslint/js": "^10.0.1",
		"@stylistic/eslint-plugin": "^5.10.0",
		"typescript-eslint": "^8.71.2"
	},
	"devDependencies": {
		"eslint": "^10.12.0",
		"typescript": "^6.0.3"
	},
	"peerDependencies": {
		"eslint": "^10.8.0",
		"typescript": ">=4.8.4 <6.1.0"
	},
	"engines": {
		"node": "^20.19.0 || ^22.13.0 || >=24.0.0"
	},
	"devEngines": {
		"runtime": {
			"name": "node",
			"version": "^22.18.0 || >=24.0.0"
		}
	}
}
